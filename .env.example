# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional server-side admin dashboard passcode.
# If unset, the Admin portal displays a first-run setup form to claim the initial passcode.
ADMIN_PASSCODE=

# SMTP Configuration for automated confirmation emails (optional; falls back to in-app dispatch log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Joker Hotel & Suites <reservations@jokerhotelsuites.com>"

# Payment Gateway Secret Keys (optional live gateway keys)
PAYSTACK_SECRET_KEY=
STRIPE_SECRET_KEY=
